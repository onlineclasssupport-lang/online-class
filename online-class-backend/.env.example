APP_NAME="Online Class"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_class
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=public

SESSION_DRIVER=file
SESSION_LIFETIME=120

# The React dev server origin, so the browser is allowed to call the API.
FRONTEND_URL=http://localhost:5173

# Razorpay -- get these from the Razorpay Dashboard (Settings > API Keys).
# Use the "test mode" keys while developing. Never put the key SECRET in
# frontend code; only RAZORPAY_KEY_ID is ever sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks, after you add the webhook
# URL below. Required for payments to confirm reliably (see SETUP.md).
RAZORPAY_WEBHOOK_SECRET=
# Price of Online Class access, in the smallest currency unit (paise for
# INR) -- 49900 = INR 499.00.
RAZORPAY_COURSE_AMOUNT=49900
RAZORPAY_CURRENCY=INR
